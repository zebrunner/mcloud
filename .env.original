# The settings of docker-compose.yml, ./zebrunner.sh setup writes .env from this file
STF_URL=http://localhost:8082
STF_PORT=8082
# the host address of the ports the nodes connect to (ZeroMQ, the grid), README.md#firewall: the LAN address of the
# server for the nodes in its network or on the server itself (README.md#devices-on-the-mcloud-server)
AGENTS_ADDRESS=0.0.0.0
# the host the nodes reach these ports at (README.md#nodes): AGENTS_ADDRESS, the host of STF_URL for 0.0.0.0; written by
# ./zebrunner.sh setup and start, the host of the join string and of the ZeroMQ endpoints stf-api gives the nodes
NODES_HOST=localhost
# adb-relay, the remote debug (adb connect of STF) of the Android devices of the nodes in a private network
# through this server (README.md#remote-debug-through-the-adb-relay). true: the remote debug ports of the devices of the
# enrolled nodes, read from the STF API with STF_TOKEN every ADB_RELAY_SYNC_SECONDS, only in the range ADB_RELAY_PORTS
# (<first>-<last> opened in the firewall, empty: any port)
ADB_RELAY=false
ADB_RELAY_PORTS=
ADB_RELAY_SYNC_SECONDS=300

# the rotation of the logs of every service: the size of a file and the number of the files
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# Docker Images
TAG_NGINX=1.31.7

# MCloud: public.ecr.aws/zebrunner/mcloud-grid and public.ecr.aws/zebrunner/stf
TAG_SELENIUM_HUB=3.1-develop-latest
TAG_RETHINKDB=2.4.3
TAG_STF=3.1-develop-latest

# Authentication
AUTH_SYSTEM=auth-mock
AUTH_URL=auth/mock/

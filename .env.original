# The settings of docker-compose.yml, ./zebrunner.sh setup writes .env from this file
STF_URL=http://localhost:8082
STF_PORT=8082
# the host address of the ports the device hosts connect to (ZeroMQ, the grid), README.md#firewall
AGENTS_ADDRESS=0.0.0.0
# the host address of the port of RethinkDB: only the device hosts of an earlier MCloud connect to it
RETHINKDB_ADDRESS=127.0.0.1
# the device hosts (STF_PROVIDER_HOST of mcloud-agent) separated by commas: stf-proxy serves the screens of their devices
AGENT_HOSTS=

# the rotation of the logs of every service: the size of a file and the number of the files
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# Docker Images
TAG_NGINX=1.31.7

# MCloud: public.ecr.aws/zebrunner/mcloud-grid and public.ecr.aws/zebrunner/stf
TAG_SELENIUM_HUB=3.1
TAG_RETHINKDB=2.4.3
TAG_STF=3.1

# Authentication
AUTH_SYSTEM=auth-mock
AUTH_URL=auth/mock/

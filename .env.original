# The settings of docker-compose.yml, ./zebrunner.sh setup writes .env from this file
STF_URL=http://localhost:8082
STF_PORT=8082
# the host address of the ports the nodes connect to (ZeroMQ, the grid), README.md#firewall: the LAN address of the
# server for the nodes in its network or on the server itself (README.md#devices-on-the-mcloud-server)
AGENTS_ADDRESS=0.0.0.0
# the host the nodes reach these ports at (README.md#nodes): AGENTS_ADDRESS, the host of STF_URL for 0.0.0.0; written by
# ./zebrunner.sh setup and start, the host of the join string and of the ZeroMQ endpoints stf-api gives the nodes
NODES_HOST=localhost
# adb-relay, the remote debug (adb connect of STF) of the Android devices of the nodes in a private network
# through this server (README.md#remote-debug-through-the-adb-relay). true: the remote debug ports of the devices of the
# enrolled nodes, read from the STF API with STF_TOKEN every ADB_RELAY_SYNC_SECONDS, only in the range ADB_RELAY_PORTS
# (<first>-<last> opened in the firewall, empty: any port)
ADB_RELAY=false
ADB_RELAY_PORTS=
ADB_RELAY_SYNC_SECONDS=300
# the MDM of the devices (README.md#mdm): mcloud-mdm with NanoHUB (iOS) and Headwind MDM (Android), https only. true:
# the services of the profile mdm. MDM_SITE_ADDRESSES: the fixed public addresses of the sites of the devices and of
# the nodes, comma separated (203.0.113.10,198.51.100.0/24), the only ones that reach the MDM; MDM_MQTT_PORT: MQTT over
# TLS of the Android agents (opened for these addresses); MDM_ADMIN_PORT: the admin UI on 127.0.0.1 of the server (an
# ssh tunnel); MDM_ADMIN_PUBLIC=true: also /mcloud/mdm/ for the admins of STF; MDM_ENFORCE_NODE_BINDING=true: a node
# acts on the MDM of the devices STF binds to it only (needs STF_TOKEN and an STF and mcloud-mdm with the binding)
MDM_ENABLED=false
MDM_SITE_ADDRESSES=
MDM_MQTT_PORT=31443
MDM_ADMIN_PORT=9101
MDM_ADMIN_PUBLIC=false
MDM_ENFORCE_NODE_BINDING=false
# the WireGuard tunnel of the nodes (README.md#wireguard-tunnel-of-the-nodes), off by default. true: the service wireguard
# (interface mcloud, the UDP port NODES_WG_PORT opened in the firewall for the nodes) and every flow between the server
# and its nodes (ZeroMQ, the grid, the screens, Appium, adb-relay) goes through it; the ports of the nodes listen on
# the WireGuard address of the server only, the first host of NODES_WG_NETWORK, the nodes get the next ones (the
# nodes are invited again to enroll with a key). NODES_WG_SYNC_SECONDS: the peers are read from the STF API so often
NODES_WIREGUARD=false
NODES_WG_PORT=51820
NODES_WG_NETWORK=10.234.0.0/24
NODES_WG_SYNC_SECONDS=5
# written by ./zebrunner.sh setup and start, not set by hand, empty without the tunnel: the address the ports of the
# nodes are published on (AGENTS_ADDRESS without it; 127.0.0.1 with it, the service wireguard relays them from the
# WireGuard address of the server), the port of stf-proxy the relay reaches the grid of the nodes at (4447: it gives the
# address of the node by the PROXY protocol; 4446 without the tunnel), the UDP endpoint of the server for the nodes (the
# host of STF_URL), the public key of NODES_WG_PRIVATE_KEY of variables.env and the WireGuard address of the server
NODES_ADDRESS=
NODES_GRID_PORT=
NODES_WG_ENDPOINT=
NODES_WG_PUBLIC_KEY=
NODES_WG_SERVER_ADDRESS=
# the proxies in front of stf-proxy (README.md#a-proxy-in-front-of-stf-proxy), comma separated (10.0.0.5,172.18.0.0/16):
# the only clients whose X-Forwarded-For and X-Forwarded-Proto stf-proxy takes; empty: none, the scheme and the address
# of a request are the ones stf-proxy sees
TRUSTED_PROXY_ADDRESSES=

# the rotation of the logs of every service: the size of a file and the number of the files
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# Docker Images
TAG_NGINX=1.31.7
# the WireGuard tunnel of the nodes: alpine with wireguard-tools, iproute2 and curl of its packages
TAG_ALPINE=3.24.4

# MCloud: public.ecr.aws/zebrunner/mcloud-grid and public.ecr.aws/zebrunner/stf
TAG_SELENIUM_HUB=3.1-develop-latest
TAG_RETHINKDB=2.4.4-bookworm-slim
TAG_STF=3.1-develop-latest
# the MDM: public.ecr.aws/zebrunner/mcloud-mdm, ghcr.io/micromdm/nanohub, mysql, headwindmdm/hmdm, postgres
TAG_MDM=0.1-develop-latest
TAG_NANOHUB=0.2.0
TAG_MDM_MYSQL=8.4
TAG_HMDM=0.1.9
TAG_MDM_POSTGRES=16-alpine

# Authentication
AUTH_SYSTEM=auth-mock
AUTH_URL=auth/mock/

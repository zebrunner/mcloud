# The settings of the STF and grid services, ./zebrunner.sh setup writes variables.env from this file
# STF
# the secret of the sessions and access tokens of STF, ./zebrunner.sh setup generates it for a new deployment
SECRET=password
# the token of the STF units for the storage routes, the same value as STF_STORAGE_TOKEN of mcloud-agent
STF_STORAGE_TOKEN=
RETHINKDB_PORT_28015_TCP=tcp://rethinkdb:28015
# the password of the admin of RethinkDB, ./zebrunner.sh setup generates it, stf migrate sets it in the database
RETHINKDB_ENV_AUTHKEY=
# the ZeroMQ security of STF (CURVE), ./zebrunner.sh setup generates the keys: the pair of the triproxies, the secret
# key of the STF units and the public keys of the device hosts (mcloud-agent) separated by commas
STF_ZMQ_CURVE_SERVER_SECRET_KEY=
STF_ZMQ_CURVE_SERVER_PUBLIC_KEY=
STF_ZMQ_CURVE_SECRET_KEY=
STF_ZMQ_CURVE_CLIENT_KEYS=

# STF - SELENIUM HUB integration
STF_URL=http://localhost:8082
STF_TOKEN=

STF_ROOT_GROUP_NAME=MCloud
STF_ADMIN_NAME=admin
STF_ADMIN_EMAIL=admin@zebrunner.com

ZEBRUNNER_LOGIN_URL=
ZEBRUNNER_USERINFO_URL=

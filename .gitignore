# >>> mcloud-conventions: the shared part, changed in https://github.com/zebrunner/mcloud-conventions
# IDE
.idea/
*.iml
# the lint tools of `make lint`
.venv/
# macOS
.DS_Store
# <<< mcloud-conventions
# the project: the local settings and data of a deployment, written by ./zebrunner.sh setup and backup
backup/settings.env
variables.env_*
.env_*
.disabled
*.bak
*.tar.gz
.env
variables.env
grid.env
configuration/stf-proxy/nginx.conf
configuration/stf-proxy/nginx.conf.previous
configuration/stf-proxy/nginx.conf.sha256
configuration/adb-relay/stf-token
configuration/stf-proxy/grid-auth.conf
# the secrets and the MQTT proxy of the MDM (README.md#mdm)
mdm.env
configuration/mdm/env/
configuration/mdm/mqtt.conf
# the basic authentication of the grid of an earlier MCloud
configuration/stf-proxy/htpasswd/
configuration/stf-proxy/ssl/ssl.crt
configuration/stf-proxy/ssl/ssl.key
# the copies of the files of a deployment kept by hand (variables.env.pre-upgrade, .env.20261117, ...): their secrets
.env.*
!.env.original
variables.env.*
!variables.env.original
grid.env.*
mdm.env.*
configuration/stf-proxy/nginx.conf.*
!configuration/stf-proxy/nginx.conf.original
configuration/stf-proxy/ssl/*.key*
configuration/stf-proxy/ssl/*.pem
# the key material of the MDM and the farm, kept out of the checkout anyway (README of mcloud-mdm: Keys and certificates)
*.p12
*.pfx
*.jks
*.keystore
*.key
*.pem
*.der
*.csr
*.mobileconfig

user  nginx;
worker_processes  1;

error_log   /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
  # the content types of the static files of the grid console, X-Content-Type-Options needs them
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  server_tokens off;

  # $grid_auth_secret: the secret the grid takes the users of this proxy with, GRID_AUTH_SECRET of variables.env;
  # ./zebrunner.sh setup and start write it
  include /etc/nginx/grid-auth.conf;

  # the scheme of the client for STF (a Secure session cookie behind https): the one of a proxy in front
  # of this one (e.g. the nginx of Zebrunner CE), otherwise the one of this server
  map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
  }

  # HSTS over https only: the browsers keep to https for a year; not includeSubDomains, the other sites of the domain
  # are not MCloud. Every add_header of the security headers below sends it, nginx skips an empty value
  map $forwarded_proto $hsts {
    https "max-age=31536000";
    default "";
  }

  # the enrollment of the nodes (README.md#nodes): an invite is guessed by nobody, the limit keeps the API from the tries
  # anyway, 6 a minute per address with a burst of 3
  limit_req_zone $binary_remote_addr zone=node_enroll:1m rate=6r/m;
  # the diagnostics of a node with its token (./zebrunner.sh doctor of mcloud-agent): 30 a minute per address
  limit_req_zone $binary_remote_addr zone=node_self:1m rate=30r/m;

  # the MDM of the devices (README.md#mdm): the sites that reach it, written by ./zebrunner.sh with MDM_ENABLED=true;
  # none without it
  include /etc/nginx/mdm/http-*.conf;

  server {
    listen 80;
    server_name stf-proxy;

    # the ssl of https: ./zebrunner.sh setup uncomments these lines and listens with ssl, the certificate is
    # configuration/stf-proxy/ssl/ssl.crt and its key ssl.key (README.md#https)
#    ssl_certificate /etc/nginx/ssl/ssl.crt;
#    ssl_certificate_key /etc/nginx/ssl/ssl.key;
#    ssl_session_timeout 5m;
#    ssl_session_cache shared:SSL:10m;
#    ssl_protocols TLSv1.2 TLSv1.3;
#    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305';
#    ssl_prefer_server_ciphers off;


    #to resolve issue with uploading huge files (Error 413)
    client_max_body_size 1024M;

    resolver 127.0.0.11 valid=30s;
    resolver_timeout 10s;

    # the MDM of the devices (README.md#mdm): its paths, written by ./zebrunner.sh with MDM_ENABLED=true; none without it
    include /etc/nginx/mdm/server-*.conf;

    # the security headers of every response; a location with its own add_header repeats them, as it does not
    # inherit these ones. MCloud is not embedded into other sites: only its own pages may frame it.
    proxy_hide_header X-Powered-By;
    add_header Strict-Transport-Security $hsts always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;

    # MCloud: the grid lets in the users of STF only (README.md#access-to-the-grid). stf-api decides about every request
    # (/_hub_auth/<scope>): the hub, the Playwright sessions and the termination of a session take an access token of
    # the user (https://<user>:<token>@<host>/mcloud/wd/hub, or Bearer <token>), the console and the devices also the
    # session cookie of STF, the metrics an admin. The grid gets the user of the decision with the secret of this proxy
    # (configuration/stf-proxy/grid-auth.conf), never the Authorization or the Cookie of the client: it would pass them
    # on to the nodes

    # the status of the hub (with the versions of the system and Java of the grid) for the users of STF: the session
    # cookie or an access token (a monitoring: Basic <user>:<token>); the grid gets no header of the client
    location = /mcloud/wd/hub/status {
      auth_request /_hub_auth/console;
      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/wd/hub/status;
      proxy_http_version 1.1;
      proxy_pass_request_headers off;
      add_header Strict-Transport-Security $hsts always;
      add_header Referrer-Policy "no-referrer" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header Content-Security-Policy "frame-ancestors 'self'" always;
    }

    location  ~ ^/mcloud/wd/(.*)$ {
      # the preflight of a client in a browser has no credential
      if ($request_method = OPTIONS) {
        return 204;
      }
      auth_request /_hub_auth/hub;
      auth_request_set $hub_user $upstream_http_x_mcloud_user;
      auth_request_set $hub_admin $upstream_http_x_mcloud_admin;
      auth_request_set $hub_token $upstream_http_x_mcloud_token;
      error_page 401 = @hub_unauthorized;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/wd/$1$is_args$args;
      proxy_http_version 1.1;

      proxy_set_header        Connection "";
      proxy_set_header        Host $host;
      proxy_set_header        X-Real-IP $remote_addr;
      proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header        Authorization "";
      proxy_set_header        Cookie "";
      proxy_set_header        X-MCloud-Auth $grid_auth_secret;
      proxy_set_header        X-MCloud-User $hub_user;
      proxy_set_header        X-MCloud-Admin $hub_admin;
      proxy_set_header        X-MCloud-Token $hub_token;
      proxy_connect_timeout   120;
      proxy_send_timeout      1200;
      proxy_read_timeout      1200;
      # the answers of the hub (a screenshot, a page source) above 64k are buffered in up to 32 MiB, then in a temporary
      # file: the memory of a request stays bounded
      proxy_buffers           32 1m;
      proxy_buffer_size       64k;
      proxy_next_upstream    error timeout http_502 http_503 http_504;
      client_max_body_size    64m;
      client_body_buffer_size 64m;
      add_header Access-Control-Allow-Methods "GET,PUT,OPTIONS,POST,DELETE";
      # any origin, without credentials: a browser refuses Allow-Credentials with the origin *
      add_header Access-Control-Allow-Origin "*";
      add_header Access-Control-Allow-Headers "Content-Type,Authorization";
      add_header Strict-Transport-Security $hsts always;
      add_header Referrer-Policy "no-referrer" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header Content-Security-Policy "frame-ancestors 'self'" always;
    }

    # the WebSocket of a Playwright session of the grid: /mcloud/playwright/<session id>, see README.md#playwright; the
    # grid passes it on to the node of the session, the WebSocket lives as long as the test (the grid pings both sides)
    location ~ ^/mcloud/playwright/([^/]+)$ {
      auth_request /_hub_auth/hub;
      auth_request_set $hub_user $upstream_http_x_mcloud_user;
      auth_request_set $hub_admin $upstream_http_x_mcloud_admin;
      auth_request_set $hub_token $upstream_http_x_mcloud_token;
      error_page 401 = @hub_unauthorized;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/grid/admin/PlaywrightServlet/$1;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header X-MCloud-Auth $grid_auth_secret;
      proxy_set_header X-MCloud-User $hub_user;
      proxy_set_header X-MCloud-Admin $hub_admin;
      proxy_set_header X-MCloud-Token $hub_token;
      proxy_connect_timeout 60;
      proxy_send_timeout    3600;
      proxy_read_timeout    3600;
      proxy_buffering off;
    }

    # the termination of a session (an access token: STF releases the device with it)
    location ~ ^/mcloud/grid/admin/TerminateSessionServlet/?$ {
      auth_request /_hub_auth/hub;
      auth_request_set $hub_user $upstream_http_x_mcloud_user;
      auth_request_set $hub_admin $upstream_http_x_mcloud_admin;
      auth_request_set $hub_token $upstream_http_x_mcloud_token;
      error_page 401 = @hub_unauthorized;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/grid/admin/TerminateSessionServlet$is_args$args;
      proxy_http_version 1.1;
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header X-MCloud-Auth $grid_auth_secret;
      proxy_set_header X-MCloud-User $hub_user;
      proxy_set_header X-MCloud-Admin $hub_admin;
      proxy_set_header X-MCloud-Token $hub_token;
      proxy_connect_timeout   60;
      proxy_send_timeout      300;
      proxy_read_timeout      300;
    }

    # the console of the grid for a signed-in user of STF, the sign-in otherwise
    location ~ ^/mcloud/grid/console/?$ {
      auth_request /_hub_auth/console;
      auth_request_set $hub_user $upstream_http_x_mcloud_user;
      auth_request_set $hub_admin $upstream_http_x_mcloud_admin;
      auth_request_set $hub_token $upstream_http_x_mcloud_token;
      error_page 401 = @console_sign_in;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/grid/console$is_args$args;
      proxy_http_version 1.1;
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header X-MCloud-Auth $grid_auth_secret;
      proxy_set_header X-MCloud-User $hub_user;
      proxy_set_header X-MCloud-Admin $hub_admin;
      proxy_set_header X-MCloud-Token $hub_token;
      proxy_connect_timeout   60;
      proxy_send_timeout      300;
      proxy_read_timeout      300;
    }

    # the devices and the sessions of the grid as JSON: a user sees the own sessions, an admin all of them
    location ~ ^/mcloud/grid/admin/(?<grid_servlet>DevicesServlet|AllSessionsServlet)/?$ {
      auth_request /_hub_auth/console;
      auth_request_set $hub_user $upstream_http_x_mcloud_user;
      auth_request_set $hub_admin $upstream_http_x_mcloud_admin;
      auth_request_set $hub_token $upstream_http_x_mcloud_token;
      error_page 401 = @hub_unauthorized;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/grid/admin/$grid_servlet$is_args$args;
      proxy_http_version 1.1;
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header X-MCloud-Auth $grid_auth_secret;
      proxy_set_header X-MCloud-User $hub_user;
      proxy_set_header X-MCloud-Admin $hub_admin;
      proxy_set_header X-MCloud-Token $hub_token;
      proxy_connect_timeout   60;
      proxy_send_timeout      300;
      proxy_read_timeout      300;
    }

    # the metrics of the grid for an admin (Prometheus: an access token of an admin as Bearer)
    location ~ ^/mcloud/grid/admin/MetricsServlet/?$ {
      auth_request /_hub_auth/admin;
      auth_request_set $hub_user $upstream_http_x_mcloud_user;
      auth_request_set $hub_admin $upstream_http_x_mcloud_admin;
      auth_request_set $hub_token $upstream_http_x_mcloud_token;
      error_page 401 = @hub_unauthorized;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/grid/admin/MetricsServlet$is_args$args;
      proxy_http_version 1.1;
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header X-MCloud-Auth $grid_auth_secret;
      proxy_set_header X-MCloud-User $hub_user;
      proxy_set_header X-MCloud-Admin $hub_admin;
      proxy_set_header X-MCloud-Token $hub_token;
      proxy_connect_timeout   60;
      proxy_send_timeout      300;
      proxy_read_timeout      300;
    }

    # the other routes of the hub (its API, the registration of the nodes, /lifecycle-manager) are not for the users
    location /mcloud {
      return 404;
    }

    # the decision of stf-api about a request of the grid: the access token of the request (its Authorization) or the
    # session cookie of STF; 2xx lets the request in with the user in X-MCloud-*, 401 and 403 refuse it
    location ~ ^/_hub_auth/(?<hub_scope>hub|console|admin)$ {
      internal;
      set $upstream_hub_auth stf-api:3000;
      proxy_pass http://$upstream_hub_auth/api/v1/zebrunner/hub-auth?scope=$hub_scope;
      proxy_pass_request_body off;
      proxy_pass_request_headers off;
      proxy_set_header Content-Length "";
      proxy_set_header Cookie $http_cookie;
      proxy_set_header Authorization $http_authorization;
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # a client of the hub without a valid access token: the error of WebDriver, no Basic challenge, so a browser does
    # not ask for a password and send it to the hub from the pages of other sites
    location @hub_unauthorized {
      default_type application/json;
      add_header WWW-Authenticate 'Bearer realm="MCloud"' always;
      add_header Strict-Transport-Security $hsts always;
      add_header Referrer-Policy "no-referrer" always;
      add_header X-Content-Type-Options "nosniff" always;
      return 401 '{"value":{"error":"unknown error","message":"MCloud takes the requests of its users: the STF access token in the URL of the hub, https://<user>:<token>@<host>/mcloud/wd/hub (Settings, Keys of STF)","stacktrace":""}}';
    }

    # the console without a sign-in: the sign-in of STF
    location @console_sign_in {
      return 302 $forwarded_proto://$http_host/;
    }

    # the screens of the devices: the WebSocket of the STF provider of a node on a port 1024-65535. stf-api allows it
    # (/api/v1/zebrunner/screen-auth, README.md#screens-of-the-devices) only for a signed-in user of STF who uses the
    # device, at the registered address of its node and on its screen port; 401 or 403 otherwise
    location ~ "^/d/(?<stfprovider>[^/]+)/(?<udid>[^/]+)/(?<port>102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/$" {
      auth_request /_screen_auth;
      # the screen ticket of stf-api for the node: the screen WebSocket of the node takes no connection without it
      auth_request_set $screen_ticket $upstream_http_x_mcloud_screen_ticket;
      proxy_pass http://$stfprovider:$port/;
      proxy_http_version 1.1;
      # only the headers of the WebSocket and the screen ticket go to the node: never the session cookie, the access
      # token or the X-Stf-* headers of the user, the node is not trusted with them
      proxy_pass_request_headers off;
      proxy_set_header Cookie "";
      proxy_set_header Authorization "";
      proxy_set_header X-Stf-Internal-Token "";
      proxy_set_header X-MCloud-Screen-Ticket $screen_ticket;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection upgrade;
      proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;
      proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;
      proxy_set_header Sec-WebSocket-Extensions $http_sec_websocket_extensions;
      proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
      proxy_set_header Origin $http_origin;
      proxy_set_header User-Agent $http_user_agent;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
    }

    # the decision of stf-api about a screen: the session cookie of STF or an access token of the user and the original
    # URI only; 2xx lets the request in with the screen ticket of the node, 401 and 403 refuse it
    location = /_screen_auth {
      internal;
      set $upstream_screen_auth stf-api:3000;
      proxy_pass http://$upstream_screen_auth/api/v1/zebrunner/screen-auth;
      proxy_pass_request_body off;
      proxy_pass_request_headers off;
      proxy_set_header Content-Length "";
      proxy_set_header Cookie $http_cookie;
      proxy_set_header Authorization $http_authorization;
      proxy_set_header X-Original-URI $request_uri;
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # the internal routes of the registry of the nodes: the triproxies and the storage read them on stf-api:3000, never
    # through stf-proxy, and the decision about the grid (/_hub_auth above). Case-insensitive and with any suffix, as the
    # router of the API matches the path
    location ~* ^/api/v1/zebrunner/(nodes|hub-auth) {
      return 403;
    }

    # the record of a node and its devices for the node itself, with its token (./zebrunner.sh doctor of mcloud-agent):
    # limited per address
    location ~* ^/api/v1/nodes/self {
      limit_req zone=node_self burst=10 nodelay;
      limit_req_status 429;
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_node_self stf-api:3000;
      proxy_pass http://$upstream_node_self;
    }

    # the enrollment of a node with its invite (./zebrunner.sh join of mcloud-agent), without an authentication of its
    # own: limited per address. Case-insensitive and with any suffix, as the router of the API matches the path
    location ~* ^/api/v1/nodes/enroll {
      limit_req zone=node_enroll burst=3 nodelay;
      limit_req_status 429;
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_enroll stf-api:3000;
      proxy_pass http://$upstream_enroll;
    }

    location /auth/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_auth stf-auth:3000;
      proxy_pass http://$upstream_auth;
    }

    location /api/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_api stf-api:3000;
      proxy_pass http://$upstream_api;
    }

    location /s/image/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_storage_plugin_image stf-storage-plugin-image:3000;
      proxy_pass http://$upstream_storage_plugin_image;
    }

    location /s/apk/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_storage_plugin_apk stf-storage-plugin-apk:3000;
      proxy_pass http://$upstream_storage_plugin_apk;
    }

    location /s/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      client_max_body_size 2048m;
      client_body_buffer_size 128k;

      # defense in depth: /s/ serves user-uploaded blobs from this origin; sandbox
      # them so an uploaded document can never run as script on it, even if a blob
      # is ever served inline (STF forces a download, this is the second layer). A
      # location with its own add_header does not inherit the server ones, repeat
      # them (see the note above); the CSP is stricter here than the site default.
      add_header Strict-Transport-Security $hsts always;
      add_header Referrer-Policy "no-referrer" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header Content-Security-Policy "default-src 'none'; sandbox; frame-ancestors 'self'" always;

      set $upstream_storage_temp stf-storage-temp:3000;
      proxy_pass http://$upstream_storage_temp;
    }

    location /socket.io/ {
      # the WebSocket of a signed-in user (its session cookie) for the pages of MCloud only: an Origin of another site
      # is refused (cross-site WebSocket hijacking); a client without Origin is not a browser
      set $socket_origin_ok 1;
      if ($http_origin != "") {
        set $socket_origin_ok 0;
      }
      if ($http_origin = "$forwarded_proto://$http_host") {
        set $socket_origin_ok 1;
      }
      if ($socket_origin_ok = 0) {
        return 403;
      }
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_websocket stf-websocket:3000;
      proxy_pass http://$upstream_websocket;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection upgrade;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $http_x_real_ip;
    }

    location /stf {
      # single rewrite procedure after first login
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      rewrite /stf /;
    }

    location /grid {
        root   /usr/share/nginx/html;
    }

    location / {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_app stf-app:3000;
      proxy_pass http://$upstream_app;
    }
  }

  # the grid of the nodes (AGENTS_ADDRESS:4446, the grid of the join string): the registration of Appium only, the
  # grid checks the node token of it. The hub and the console are /mcloud of the server above, for the users of STF
  server {
    listen 4446;
    server_name stf-proxy-grid;

    resolver 127.0.0.11 valid=30s;
    resolver_timeout 10s;

    location = /grid/register {
      set $upstream_grid mcloud-grid:4444;
      proxy_pass http://$upstream_grid;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # the check of a registered node: GET /grid/api/proxy?id=<node url>
    location = /grid/api/proxy {
      limit_except GET {
        deny all;
      }
      set $upstream_grid mcloud-grid:4444;
      proxy_pass http://$upstream_grid;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
      return 403;
    }
  }
}

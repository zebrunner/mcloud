user  nginx;
worker_processes  1;

error_log   /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
  # the content types of the static files of the grid console, X-Content-Type-Options needs them
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  server_tokens off;

  # the scheme of the client for STF (a Secure session cookie behind https): the one of a proxy in front
  # of this one (e.g. the nginx of Zebrunner CE), otherwise the one of this server
  map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
  }

  # the enrollment of the nodes (README.md#nodes): an invite is guessed by nobody, the limit keeps the API from the tries
  # anyway, 6 a minute per address with a burst of 3
  limit_req_zone $binary_remote_addr zone=node_enroll:1m rate=6r/m;
  # the diagnostics of a node with its token (./zebrunner.sh doctor of mcloud-agent): 30 a minute per address
  limit_req_zone $binary_remote_addr zone=node_self:1m rate=30r/m;

  server {
    listen 80;
    server_name stf-proxy;

    # Uncomment below block to setup SSL on this NGiNX instance. make sure to put ssl.crt and ssl.key to nginx/ssl shared folder
#    ssl_certificate /etc/nginx/ssl/ssl.crt;
#    ssl_certificate_key /etc/nginx/ssl/ssl.key;
#    ssl_session_timeout 5m;
#    ssl_session_cache shared:SSL:10m;
#    ssl_protocols TLSv1.2 TLSv1.3;
#    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305';
#    ssl_prefer_server_ciphers off;


    #to resolve issue with uploading huge files (Error 413)
    client_max_body_size 1024M;

    resolver 127.0.0.11 valid=30s;
    resolver_timeout 10s;

    # the security headers of every response; a location with its own add_header repeats them, as it does not
    # inherit these ones. MCloud is not embedded into other sites: only its own pages may frame it.
    proxy_hide_header X-Powered-By;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;

    # MCloud
    location  ~ ^/mcloud/wd/(.*)$ {
      #auth_basic "Private MCloud Selenium Hub";
      #auth_basic_user_file /etc/nginx/htpasswd/mcloud.htpasswd;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/wd/$1;
      proxy_http_version 1.1;

      proxy_set_header        Connection "";
      proxy_set_header        Host $host;
      proxy_set_header        X-Real-IP $remote_addr;
      proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_connect_timeout   120;
      proxy_send_timeout      1200;
      proxy_read_timeout      1200;
      proxy_buffers           32 64m;
      proxy_buffer_size       64k;
      proxy_next_upstream    error timeout http_502 http_503 http_504;
      client_max_body_size    64m;
      client_body_buffer_size 64m;
      add_header Access-Control-Allow-Methods "GET,PUT,OPTIONS,POST,DELETE";
      add_header Access-Control-Allow-Origin "*";
      add_header Access-Control-Allow-Headers "Content-Type,Authorization";
      add_header Access-Control-Allow-Credentials "true";
      add_header Referrer-Policy "no-referrer" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header Content-Security-Policy "frame-ancestors 'self'" always;
    }

    # the WebSocket of a Playwright session of the grid: /mcloud/playwright/<session id>, see README.md#playwright; the
    # grid passes it on to the node of the session, the WebSocket lives as long as the test (the grid pings both sides)
    location ~ ^/mcloud/playwright/([^/]+)$ {
      #auth_basic "Private MCloud Selenium Hub";
      #auth_basic_user_file /etc/nginx/htpasswd/mcloud.htpasswd;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/grid/admin/PlaywrightServlet/$1;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_connect_timeout 60;
      proxy_send_timeout    3600;
      proxy_read_timeout    3600;
      proxy_buffering off;
    }

    location  ~ ^/mcloud/?(.*)$ {
      #auth_basic "Private MCloud Selenium Hub";
      #auth_basic_user_file /etc/nginx/htpasswd/mcloud.htpasswd;

      set $upstream_hub mcloud-grid:4444;
      proxy_pass http://$upstream_hub/$1;
      proxy_http_version 1.1;

      proxy_connect_timeout   60;
      proxy_send_timeout      300;
      proxy_read_timeout      300;
    }

    # the screens of the devices: the WebSocket of the STF provider of a node on a port 1024-65535. stf-api allows it
    # (/api/v1/zebrunner/screen-auth, README.md#screens-of-the-devices) only for a signed-in user of STF who uses the
    # device, at the registered address of its node and on its screen port; 401 or 403 otherwise
    location ~ "^/d/(?<stfprovider>[^/]+)/(?<udid>[^/]+)/(?<port>102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/$" {
      auth_request /_screen_auth;
      proxy_pass http://$stfprovider:$port/;
      proxy_http_version 1.1;
      # only the headers of the WebSocket go to the node: never the session cookie, the access token or the X-Stf-*
      # headers of the user, the node is not trusted with them
      proxy_pass_request_headers off;
      proxy_set_header Cookie "";
      proxy_set_header Authorization "";
      proxy_set_header X-Stf-Internal-Token "";
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection upgrade;
      proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;
      proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;
      proxy_set_header Sec-WebSocket-Extensions $http_sec_websocket_extensions;
      proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
      proxy_set_header Origin $http_origin;
      proxy_set_header User-Agent $http_user_agent;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
    }

    # the decision of stf-api about a screen: the session cookie of STF or an access token of the user and the original
    # URI only; 2xx lets the request in, 401 and 403 refuse it
    location = /_screen_auth {
      internal;
      set $upstream_screen_auth stf-api:3000;
      proxy_pass http://$upstream_screen_auth/api/v1/zebrunner/screen-auth;
      proxy_pass_request_body off;
      proxy_pass_request_headers off;
      proxy_set_header Content-Length "";
      proxy_set_header Cookie $http_cookie;
      proxy_set_header Authorization $http_authorization;
      proxy_set_header X-Original-URI $request_uri;
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # the internal routes of the registry of the nodes: the triproxies and the storage read them on stf-api:3000, never
    # through stf-proxy. Case-insensitive and with any suffix, as the router of the API matches the path
    location ~* ^/api/v1/zebrunner/nodes {
      return 403;
    }

    # the record of a node and its devices for the node itself, with its token (./zebrunner.sh doctor of mcloud-agent):
    # limited per address
    location ~* ^/api/v1/nodes/self {
      limit_req zone=node_self burst=10 nodelay;
      limit_req_status 429;
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_node_self stf-api:3000;
      proxy_pass http://$upstream_node_self;
    }

    # the enrollment of a node with its invite (./zebrunner.sh join of mcloud-agent), without an authentication of its
    # own: limited per address. Case-insensitive and with any suffix, as the router of the API matches the path
    location ~* ^/api/v1/nodes/enroll {
      limit_req zone=node_enroll burst=3 nodelay;
      limit_req_status 429;
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_enroll stf-api:3000;
      proxy_pass http://$upstream_enroll;
    }

    location /auth/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_auth stf-auth:3000;
      proxy_pass http://$upstream_auth;
    }

    location /api/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_api stf-api:3000;
      proxy_pass http://$upstream_api;
    }

    location /s/image/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_storage_plugin_image stf-storage-plugin-image:3000;
      proxy_pass http://$upstream_storage_plugin_image;
    }

    location /s/apk/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_storage_plugin_apk stf-storage-plugin-apk:3000;
      proxy_pass http://$upstream_storage_plugin_apk;
    }

    location /s/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      client_max_body_size 2048m;
      client_body_buffer_size 128k;

      set $upstream_storage_temp stf-storage-temp:3000;
      proxy_pass http://$upstream_storage_temp;
    }

    location /socket.io/ {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_websocket stf-websocket:3000;
      proxy_pass http://$upstream_websocket;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection upgrade;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $http_x_real_ip;
    }

    location /stf {
      # single rewrite procedure after first login
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      rewrite /stf /;
    }

    location /grid {
        root   /usr/share/nginx/html;
    }

    location / {
      proxy_set_header Host stf-proxy;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      set $upstream_app stf-app:3000;
      proxy_pass http://$upstream_app;
    }
  }
}
